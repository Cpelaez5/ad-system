# Variables de entorno del frontend (Vite).
# Todo lo que empiece con VITE_ termina incluido en el bundle del navegador,
# así que aquí SOLO van valores públicos. Las claves de IA (DeepSeek, Gemini,
# etc.) viven en el servidor: secrets de Supabase Edge Functions / vault de
# ai_provider_profiles. Nunca agregues VITE_DEEPSEEK_*, VITE_NVIDIA_* ni
# VITE_ACTIVE_AI_PROVIDER aquí ni en .env.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anonima-publica
