# Credenciales de prueba para la suite E2E (Playwright).
# Copia este archivo a `.env.e2e.local` (ya está en .gitignore) y llena los
# valores reales. NUNCA pongas credenciales reales en este archivo .example
# ni en el código de los tests.

E2E_BASE_URL=http://127.0.0.1:5174

E2E_CLIENTE_EMAIL=
E2E_CLIENTE_PASSWORD=

E2E_SUPERADMIN_EMAIL=
E2E_SUPERADMIN_PASSWORD=
